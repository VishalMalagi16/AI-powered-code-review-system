# CodeGuard AI Backend Configuration
PROJECT_NAME="CodeGuard AI"
ENVIRONMENT="development"
DEBUG=True

# Security (Replace with a strong random secret in production)
SECRET_KEY="codeguard-super-secret-development-key-change-in-production-9a8f2"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite database
DATABASE_URL="sqlite:///./codeguard.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql://user:password@localhost:5432/codeguard_db"

# AI Configuration (Server-Side Only - Never exposed to client)
# Providers: auto | gemini | openai | mock_demo | none
AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Offline Demo Mode: when True, provides local heuristic synthesis if API keys are unset
MOCK_AI_FALLBACK=True

# Rate Limits & Protection
MAX_CODE_SIZE_BYTES=500000
ANALYSIS_TIMEOUT_SECONDS=30
